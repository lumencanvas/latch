{
  "name": "latch",
  "version": "1.5.1",
  "description": "The Ultimate Creative Flow Programming Engine",
  "author": "LumenCanvas",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "electron:install": "install-electron",
    "dev:electron": "install-electron && electron-vite dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:electron": "electron-vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx",
    "new-node": "node scripts/new-node.mjs node",
    "new-category": "node scripts/new-node.mjs category",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.main.json",
    "package": "electron-vite build && electron-forge package",
    "make": "electron-vite build && electron-forge make"
  },
  "dependencies": {
