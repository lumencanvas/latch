    "dexie": "^4.0.1",
    "lucide-vue-next": "^0.344.0",
    "meyda": "^5.6.3",
    "monaco-editor": "^0.55.1",
    "mqtt": "^5.14.1",
    "nanoid": "^5.0.6",
